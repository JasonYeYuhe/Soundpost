DEFINE SCHEMA

    RECORD TYPE CD_Capsule (
        CD_audioData       BYTES QUERYABLE SORTABLE,
        CD_audioFileName   STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_createdAt       TIMESTAMP QUERYABLE SORTABLE,
        CD_durationSeconds DOUBLE QUERYABLE SORTABLE,
        CD_echoAt          TIMESTAMP QUERYABLE SORTABLE,
        CD_entityName      STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_id              STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_mood            BYTES QUERYABLE SORTABLE,
        CD_note            STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_place           BYTES QUERYABLE SORTABLE,
        CD_sealTimeZoneID  STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_sealUntil       TIMESTAMP QUERYABLE SORTABLE,
        CD_soundprintRaw   STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_state           BYTES QUERYABLE SORTABLE,
        CD_waveformSamples BYTES QUERYABLE SORTABLE,
        "___createTime"    TIMESTAMP,
        "___createdBy"     REFERENCE,
        "___etag"          STRING,
        "___modTime"       TIMESTAMP,
        "___modifiedBy"    REFERENCE,
        "___recordID"      REFERENCE,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE CD_ListeningConsent (
        CD_changedAt    TIMESTAMP QUERYABLE SORTABLE,
        CD_enabled      INT64 QUERYABLE SORTABLE,
        CD_entityName   STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_id           STRING QUERYABLE SEARCHABLE SORTABLE,
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE CD_SoundRejection (
        CD_capsuleID    STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_changedAt    TIMESTAMP QUERYABLE SORTABLE,
        CD_entityName   STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_id           STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_identifier   STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_rejected     INT64 QUERYABLE SORTABLE,
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE DeliveryIdentity (
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE,
        userKey         STRING QUERYABLE SEARCHABLE SORTABLE,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE Users (
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE,
        roles           LIST<INT64>,
        GRANT WRITE TO "_creator",
        GRANT READ TO "_world"
    );

